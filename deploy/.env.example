# Copy to deploy/.env on the deploy host (chmod 600). Never commit the real file.
DB_PASSWORD=            # openssl rand -hex 24
MYSQL_ROOT_PASSWORD=    # openssl rand -hex 24
# {bcrypt} hashes of the client secrets; raw secrets go to the Sync / Flow servers (docs/clients.md).
# Single-quote them (bcrypt contains `$`, which compose would interpolate). Sync and Flow must differ
# (the server refuses to start with duplicate client secrets).
SYNC_CLIENT_SECRET_HASH='{bcrypt}$2y$12$...'
FLOW_CLIENT_SECRET_HASH='{bcrypt}$2y$12$...' 
# Resend SMTP (domain mirattic.com verified in Resend; SPF/DKIM records in Cloudflare DNS)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=          # Resend API key (re_...), "Sending access" for mirattic.com only
